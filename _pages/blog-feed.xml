---
layout: null
permalink: /blog/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en" xml:base="{{ '/' | absolute_url | xml_escape }}">
  <title>Kuo Li — Blog</title>
  <subtitle>Technical notes and personal writing.</subtitle>
  <link href="{{ '/blog/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/blog/' | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
  <id>{{ '/blog/' | absolute_url | xml_escape }}</id>
  {% assign feed_updated = site.posts.first.last_modified_at | default: site.posts.first.date | default: site.time %}
  {% assign feed_updated_epoch = feed_updated | date: '%s' | plus: 0 %}
  {% for post in site.posts limit:20 %}{% assign entry_updated = post.last_modified_at | default: post.date %}{% assign entry_updated_epoch = entry_updated | date: '%s' | plus: 0 %}{% if entry_updated_epoch > feed_updated_epoch %}{% assign feed_updated = entry_updated %}{% assign feed_updated_epoch = entry_updated_epoch %}{% endif %}{% endfor %}
  <updated>{{ feed_updated | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name><uri>{{ '/' | absolute_url | xml_escape }}</uri></author>
  {% for post in site.posts limit:20 %}
  <entry xml:lang="{{ post.lang | default: 'en' | xml_escape }}" xml:base="{{ post.url | absolute_url | xml_escape }}">
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {% if post.description %}<summary type="text">{{ post.description | xml_escape }}</summary>{% else %}<summary type="html">{{ post.excerpt | xml_escape }}</summary>{% endif %}
    <content type="html">{{ post.content | xml_escape }}</content>
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}
  </entry>
  {% endfor %}
</feed>
